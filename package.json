{
  "name": "backend-template",
  "version": "1.5.0",
  "description": "Robust and scalable backend server template with NodeJS, TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "install:pkg": "pnpm install --frozen-lockfile",
    "preinstall": "npx only-allow pnpm",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsx watch --clear-screen=false --include './src/**/*' --env-file=.env src/server.ts",
    "dev:node": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"./.path-resolver.js\", pathToFileURL(\"./\"));' --watch --env-file=.env src/server.ts",
    "dev:n": "console-ninja pnpm dev",
    "dev:bun": "bun --watch --no-clear-screen src/server.ts",
    "build": "tsc -p tsconfig.app.json && tsc-alias -p tsconfig.app.json",
    "build:bun": "bun build src/server.ts --target bun --outdir dist",
    "fmt": "bun fmt",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --max-warnings 0 --fix",
    "format": "prettier --log-level warn --write \"./**/*.{js,cjs,mjs,ts,json,yaml,yml,html,md}\"",
    "test": "vitest run",
    "test:w": "vitest --watch",
    "coverage": "vitest run --coverage",
    "docker": "docker compose up --build -d",
    "docker-stage": "docker compose -f docker-compose.stage.yml up --build -d",
    "docker:sh": "docker exec -it template-server sh",
    "docker-stage:sh": "docker exec -it template-server-stage sh",
    "redis-cli": "docker exec -it redis redis-cli",
    "lint-staged": "lint-staged",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "Saiful Islam Sojib",
  "license": "ISC",
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stack-lint/base": "^0.3.0",
    "@stack-lint/node": "^0.3.1",
    "@stack-lint/typescript": "^0.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=11",
    "pnpm": ">=12"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts}": [
      "eslint --max-warnings 0 --fix",
      "vitest related --run"
    ],
    "*.{js,cjs,mjs,ts,json,yaml,yml,html,md}": "prettier --log-level warn --write"
  }
}
