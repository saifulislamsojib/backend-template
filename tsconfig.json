{
  "compilerOptions": {
    // Environment Settings
    "module": "ESNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "skipLibCheck": true,

    // Bundler/Build Options
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "removeComments": true,
    "noEmitOnError": true,
    "resolveJsonModule": true,

    // Stricter Typechecking or Linting Options
    "strict": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": true,

    // Path Alias
    "paths": {
      "@/*": ["./src/*"]
    }
  },

  // Solution-style root: references the app and test projects so that
  // `tsc -b` type-checks both and editors pick the right project per file.
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.test.json" }]
}
